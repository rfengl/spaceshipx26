# Copy this file to .env (in the server/ folder) and adjust values as needed.

# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# CORS: comma-separated list of allowed origins, or * for all
CORS_ORIGIN=*

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# SQLite database file path (use :memory: for an ephemeral DB)
DB_PATH=data/prms.db

# JWT auth — CHANGE THE SECRET in production
JWT_SECRET=dev-insecure-secret-change-me
JWT_EXPIRES_IN=1h
